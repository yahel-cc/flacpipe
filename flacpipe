    if not habilitado:
        problemas.append("plugin no habilitado")
    linea(ok if descargas_ok else duda,
          "downloaddir apunta a .descargas" if descargas_ok
          else "downloaddir NO apunta a .descargas (las descargas manuales ensucian la biblioteca)")

    alcanza = _snap_lee_plugin()
    if alcanza is True:
        linea(ok, "el snap confinado alcanza el código del plugin")
    elif alcanza is False:
        linea(mal, "el snap NO puede leer el plugin (AppArmor)",
              "mueve el código a una ruta sin punto inicial dentro de $HOME")
        problemas.append("snap no lee el plugin")
    else:
        linea(duda, "no pude comprobar el acceso del snap")

    for d in (comun.DIR_PIPELINE, comun.DIR_DESCARGAS, comun.RAIZ_BIBLIOTECA):
        linea(ok if os.access(d, os.W_OK) else mal, f"{d} escribible")

    print("\n▸ Nicotine+")
    pid = comun.pid_nicotine()
    if pid is None:
        linea(mal, "Nicotine+ NO está corriendo", "ábrelo, o: flacpipe arrancar")
        problemas.append("Nicotine+ cerrado")
    else:
        linea(ok, f"Nicotine+ corriendo (pid {pid})")
        arranque_proceso = os.path.getmtime(f"/proc/{pid}")
        arranque_plugin = _ultimo_arranque_plugin()
        if arranque_plugin is None:
            linea(mal, "el plugin nunca se ha cargado",
                  "no hay '[plugin] activado' en pipeline.log")
            problemas.append("plugin sin cargar")
        elif arranque_plugin >= arranque_proceso - 5:
            import datetime
            cuando = datetime.datetime.fromtimestamp(arranque_plugin).strftime("%H:%M:%S")
            linea(ok, f"el plugin se cargó en esta sesión de Nicotine+ ({cuando})")
        else:
            linea(mal, "el plugin no se cargó en esta sesión de Nicotine+",
                  "mira el log de Nicotine+ por si dio error al cargar")
            problemas.append("plugin no cargado en esta sesión")

    print("\n▸ Cola")
    cola = comun.leer_cola()
    activas = [p for p in cola["peticiones"] if p["estado"] in comun.ACTIVOS]
    linea(ok, f"{len(activas)} petición(es) activas, {len(cola['peticiones'])} en total")
    pendientes = len(_sobras_descargas()) + len(_sueltos_descargas())
