import os
import shutil
import sys

DIR_PLUGIN = os.path.join(os.path.dirname(os.path.realpath(__file__)), "flac_hunter")
sys.path.insert(0, DIR_PLUGIN)

import fh_biblioteca as biblioteca   # noqa: E402
import fh_comun as comun             # noqa: E402
import fh_fiio as fiio               # noqa: E402
import fh_listas as listas           # noqa: E402

ICONOS = {
    comun.PENDIENTE: "⧗",
    comun.BUSCANDO: "⟳",
    comun.DESCARGANDO: "↓",
    comun.LISTO: "✓",
    comun.FALLIDO: "✗",
    comun.CANCELADO: "⊘",
}


def _nicotine_activo():
    return comun.pid_nicotine() is not None


# ─── pedir ────────────────────────────────────────────────────────────────────

def cmd_pedir(args):
    if args.csv:
        return _pedir_csv(args)
    consultas = list(args.consulta)
    if args.archivo:
        with open(args.archivo, encoding="utf-8") as f:
            consultas += [l.strip() for l in f
                          if l.strip() and not l.lstrip().startswith("#")]
    if not consultas:
        print("Nada que encolar. Pasa consultas o --archivo.")
        return 1

    tipo = "cancion" if args.cancion else "album"
    creadas = comun.añadir_peticiones(consultas, tipo=tipo)

    for pet in creadas:
        print(f"⧗ encolado  {pet['consulta']}")
    repetidas = len(consultas) - len(creadas)
    if repetidas:
        print(f"({repetidas} ya estaban en la cola, se ignoran)")

    if creadas and not _nicotine_activo():
        print("\n!  Nicotine+ no está corriendo: la cola no avanzará hasta abrirlo.")
        print("   Ábrelo normalmente, o sin ventana con:  flacpipe arrancar")
    return 0


def _pedir_csv(args):
    """Una playlist exportada en CSV: se piden sus canciones una a una (o sus
    álbumes con --albumes), saltando lo que ya está en la biblioteca o en la cola."""
    try:
        plan = listas.plan(args.csv, albumes=args.albumes, repetir=args.repetir)
    except (OSError, ValueError) as error:
        print(f"✗ {args.csv}: {error}")
        return 1

    que = "álbumes" if plan["tipo"] == "album" else "canciones"
    print(f"«{plan['nombre']}»  ·  {len(plan['canciones'])} canciones en el CSV")
    for aviso in plan["avisos"]:
        print(f"!  {aviso}")
    if plan["tenidas"]:
        print(f"\nYa en la biblioteca, no se piden ({len(plan['tenidas'])}):")
        for e in plan["tenidas"]:
            print(f"   ✓ {e['consulta']}")
    if plan["en_cola"]:
        print(f"\nYa en la cola ({len(plan['en_cola'])}):")
        for e in plan["en_cola"]:
            print(f"   {ICONOS.get(e['estado'], '·')} {e['consulta']}")
    if not plan["pedir"]:
        print("\nNada que pedir.")
        return 0

    albumes = plan["tipo"] == "album"
    print(f"\nSe piden {len(plan['pedir'])} {que}  "
          f"({listas.estimacion(len(plan['pedir']), albumes)}, {listas.ritmo(albumes)}):")
    for e in plan["pedir"]:
        print(f"   ⧗ {e['consulta']}")
    if args.simular:
        print("\n(simulación: no se encoló nada; quita --simular para pedirlas)")
        return 0

    creadas = listas.encolar(plan)
    print(f"\n⧗ encoladas {len(creadas)} {que} de «{plan['nombre']}»")
    if creadas and not _nicotine_activo():
        print("\n!  Nicotine+ no está corriendo: la cola no avanzará hasta abrirlo.")
        print("   Ábrelo normalmente, o sin ventana con:  flacpipe arrancar")
    return 0


# ─── estado ───────────────────────────────────────────────────────────────────

def cmd_estado(args):
    if args.seguir:
        return _seguir_estado(args)
    return _pintar_estado(args)


def _seguir_estado(args):
    """Repinta el estado cada pocos segundos hasta que la cola se vacíe o Ctrl-C."""
    import time
    try:
        while True:
            print("\033[2J\033[H", end="")  # limpiar pantalla
            print(f"flacpipe estado --seguir   ({time.strftime('%H:%M:%S')})  Ctrl-C para salir\n")
            _pintar_estado(args)
            _pintar_log(6)
            cola = comun.leer_cola()
            if not any(p["estado"] in comun.ACTIVOS for p in cola["peticiones"]):
                print("\nNo queda nada activo en la cola.")
                return 0
            time.sleep(5)
    except KeyboardInterrupt:
        print()
        return 0


def _pintar_log(lineas):
    try:
        with open(comun.ARCHIVO_LOG, encoding="utf-8", errors="replace") as f:
            cola_log = f.readlines()[-lineas:]
    except OSError:
        return
    if cola_log:
        print("\n  ── pipeline.log ──")
        for l in cola_log:
            print("  " + l.rstrip())


def _pintar_estado(args):
    cola = comun.leer_cola()
    peticiones = cola["peticiones"]
    if not args.todo:
        peticiones = [p for p in peticiones if p["estado"] in comun.ACTIVOS][-30:] or peticiones[-15:]

    if not peticiones:
        print("La cola está vacía.")
    else:
        for pet in peticiones:
            icono = ICONOS.get(pet["estado"], "•")
            linea = f"{icono} {pet['consulta']}"
            if pet["estado"] == comun.DESCARGANDO and pet.get("progreso"):
                p = pet["progreso"]
                linea += f"  [{p.get('terminados', 0)}/{p.get('total', 0)}]"
            print(linea)
            if pet.get("resultado"):
                r = pet["resultado"]
                print(f"     → {r['carpeta']}  ·  {r['pistas']} pistas  ·  {r['calidad']}")
                if r.get("faltantes"):
                    print("     !  INCOMPLETO, faltan las pistas "
                          + ", ".join(f"{n:02d}" for n in r["faltantes"])
                          + f"   (recupéralo con: flacpipe pedir \"{pet['consulta']}\")")
            elif pet.get("mensaje"):
                print(f"     {pet['mensaje']}")

    activas = sum(1 for p in cola["peticiones"] if p["estado"] in comun.ACTIVOS)
    print(f"\n{activas} en curso · {len(cola['peticiones'])} en total")
    if activas and not _nicotine_activo():
        print("!  Nicotine+ no está corriendo: la cola está detenida.")

    sobras = _sobras_descargas()
    sueltos = _sueltos_descargas()
    if sobras or sueltos:
        partes = []
        if sobras:
            partes.append(f"{len(sobras)} carpeta(s)")
        if sueltos:
            partes.append(f"{len(sueltos)} archivo(s) suelto(s)")
        print(f"!  {' y '.join(partes)} sin organizar en .descargas "
              f"(usa: flacpipe organizar)")
    return 0


def _sobras_descargas():
    try:
        entradas = sorted(os.listdir(comun.DIR_DESCARGAS))
    except OSError:
        return []
    return [os.path.join(comun.DIR_DESCARGAS, d) for d in entradas
            if os.path.isdir(os.path.join(comun.DIR_DESCARGAS, d))]


def _sueltos_descargas():
    """FLAC sueltos en la raíz de .descargas (una descarga manual de Nicotine+)."""
    try:
        entradas = sorted(os.listdir(comun.DIR_DESCARGAS))
    except OSError:
        return []
    return [os.path.join(comun.DIR_DESCARGAS, a) for a in entradas
            if a.lower().endswith(biblioteca.EXT_AUDIO) and not a.startswith("._")
            and os.path.isfile(os.path.join(comun.DIR_DESCARGAS, a))]


def _agrupar_sueltos(simular=False):
    """Agrupa los FLAC sueltos por (artista, álbum) en carpetas temporales.

    Nicotine+ deja las descargas de archivos individuales planas en downloaddir.
    Agruparlas así permite reusar el mismo organizador que para un álbum entero.
    """
    sueltos = _sueltos_descargas()
    if not sueltos:
        return []

    grupos = {}
    for ruta in sueltos:
        tags = biblioteca.leer_tags(ruta)
        if "ERROR" in tags:
            print(f"   !  {os.path.basename(ruta)}: {tags['ERROR']} — se deja donde está")
            continue
        artista = (tags.get("ALBUMARTIST") or tags.get("ARTIST") or "").strip()
        album = (tags.get("ALBUM") or "").strip()
        if not artista or not album:
            print(f"   !  {os.path.basename(ruta)}: sin ARTIST/ALBUM en los tags "
                  f"— se deja donde está")
            continue
        grupos.setdefault((artista, album), []).append(ruta)

    carpetas = []
    for (artista, album), rutas in grupos.items():
        print(f"   ↳ {len(rutas)} suelta(s) de {artista} — {album}")

        if simular:
            # Sin mover nada: se calcula el nombre final con las mismas funciones
            destino_rel = os.path.join(biblioteca.sanear(artista, 80),
                                       biblioteca.sanear(album, 90))
            for ruta in sorted(rutas):
                tags = biblioteca.leer_tags(ruta)
                num = biblioteca.numero(tags.get("TRACKNUMBER") or tags.get("TRACK")) or 0
                titulo = (tags.get("TITLE") or "").strip() or os.path.splitext(
                    os.path.basename(ruta))[0]
                print(f"      {os.path.basename(ruta)}")
                print(f"        → {destino_rel}/{num:02d} "
                      f"{biblioteca.sanear(titulo)}{biblioteca.EXT_AUDIO}")
            continue

        destino = os.path.join(comun.DIR_DESCARGAS,
                               "_sueltos-" + comun._slug(f"{artista} {album}"))
        os.makedirs(destino, exist_ok=True)
        for ruta in rutas:
            shutil.move(ruta, os.path.join(destino, os.path.basename(ruta)))
        carpetas.append(destino)
    return carpetas


# ─── cancelar / limpiar ───────────────────────────────────────────────────────

def cmd_cancelar(args):
    objetivo = args.cual.casefold()

    def _op(cola):
        tocadas = []
        for pet in cola["peticiones"]:
            if pet["estado"] not in comun.ACTIVOS:
                continue
            if objetivo in (pet["id"].casefold(), "todo") or objetivo in pet["consulta"].casefold():
                pet["estado"] = comun.CANCELADO
                pet["actualizado"] = comun.ahora()
                pet["mensaje"] = "cancelada a mano"
                tocadas.append(pet["consulta"])
        return tocadas

    tocadas = comun.modificar_cola(_op)
    for c in tocadas:
        print(f"⊘ cancelado  {c}")
    if not tocadas:
        print("No hay nada activo que coincida.")
    return 0


def cmd_limpiar(_args):
    def _op(cola):
        antes = len(cola["peticiones"])
        cola["peticiones"] = [p for p in cola["peticiones"] if p["estado"] in comun.ACTIVOS]
        return antes - len(cola["peticiones"])

    quitadas = comun.modificar_cola(_op)
    print(f"Se quitaron {quitadas} petición(es) terminadas de la cola.")
    return 0


# ─── organizar ────────────────────────────────────────────────────────────────

def cmd_organizar(args):
    if args.carpeta:
        carpetas = [args.carpeta]
    else:
        agrupadas = _agrupar_sueltos(simular=args.simular)
        carpetas = agrupadas + [c for c in _sobras_descargas() if c not in agrupadas]
    if not carpetas:
        print("No hay nada pendiente de organizar en .descargas.")
        return 0

    for carpeta in carpetas:
        print(f"\n▸ {os.path.basename(carpeta)}")
        resultado = biblioteca.organizar(carpeta, simular=args.simular)
        if not resultado.get("ok"):
            print(f"   ✗ {resultado.get('motivo')}")
            for aviso in resultado.get("avisos", []):
                print(f"   !  {aviso}")
            continue
        print(f"   → {resultado['carpeta']}  ·  {resultado['calidad']}")
        for nombre in resultado["nombres"]:
            print(f"      {nombre}")
        for aviso in resultado.get("avisos", []):
            print(f"   !  {aviso}")
        if resultado["omitidas"]:
            print(f"   » {resultado['omitidas']} ya existían con igual o mejor calidad")
    if args.simular:
        print("\n(simulación: no se movió nada)")
    return 0


# ─── fiio ─────────────────────────────────────────────────────────────────────

def _elegir_destino(args):
    if args.destino:
        return args.destino
    destinos = fiio.detectar_destinos()
    if not destinos:
        print("✗ No encuentro ninguna tarjeta montada en /run/media, /media ni /mnt.")
        print("   Conecta el FiiO (o el lector de la microSD) y vuelve a intentar,")
        print("   o indica la ruta a mano con --destino /ruta/al/montaje")
        return None
    if len(destinos) > 1:
        print("Hay varios destinos posibles; elige uno con --destino:")
        for d in destinos:
            print(f"   {d['montaje']}  ({d['tipo']}, "
                  f"{comun.formato_bytes(d['libre'])} libres de {comun.formato_bytes(d['total'])})")
        return None
    return destinos[0]["montaje"]


def cmd_fiio(args):
    montaje = _elegir_destino(args)
    if montaje is None:
        return 1

    destino_raiz = os.path.join(montaje, args.subcarpeta)
    albumes = fiio.listar_biblioteca(raiz=args.raiz, filtros=args.filtro)
    if not albumes:
        print("No hay álbumes que copiar (¿filtros demasiado estrictos?).")
        return 1

    total_bytes = sum(a["bytes"] for a in albumes)
    try:
        st = os.statvfs(montaje)
        libre = st.f_bavail * st.f_frsize
    except OSError:
        libre = 0

    print("=" * 72)
    print(f"  Origen  : {args.raiz or comun.RAIZ_BIBLIOTECA}")
    print(f"  Destino : {destino_raiz}")
    print(f"  Álbumes : {len(albumes)}  ·  "
          f"{sum(len(a['pistas']) for a in albumes)} pistas  ·  "
          f"{comun.formato_bytes(total_bytes)}")
    print(f"  Libre   : {comun.formato_bytes(libre)}")
    if args.simular:
        print("  MODO    : simulación, no se escribe nada")
    if args.rehacer:
        print("  MODO    : --rehacer (se BORRAN y reescriben los álbumes que ya estén)")
    print("=" * 72)

    if not args.simular and libre and total_bytes > libre:
        print(f"\n✗ No cabe: faltan {comun.formato_bytes(total_bytes - libre)}")
        return 1

    if not args.simular and not args.si:
        respuesta = input("\n¿Copiar en este orden? [s/N] ").strip().lower()
        if respuesta not in ("s", "si", "sí", "y", "yes"):
            print("Cancelado.")
            return 1

    print()
    resumen = fiio.copiar(destino_raiz, albumes,
                          simular=args.simular, rehacer=args.rehacer)

    print("\n" + "=" * 72)
    print(f"  Copiados : {resumen['copiados']} álbumes "
          f"({resumen['archivos']} archivos, {comun.formato_bytes(resumen['bytes'])})")
    if resumen["omitidos"]:
        print(f"  Ya estaban: {resumen['omitidos']}")
    if resumen["desordenados"]:
        print(f"  !  Con el orden físico en duda ({len(resumen['desordenados'])}):")
        for rel in resumen["desordenados"]:
            print(f"        {rel}")
        print("     Reescríbelos en orden con:  flacpipe fiio --rehacer " +
              " ".join(f'"{r}"' for r in resumen["desordenados"][:3]))
    for error in resumen["errores"]:
        print(f"  ✗ {error}")

    if args.desmontar and not args.simular:
        print("\nDesmontando…")
        fiio.desmontar(montaje)
    elif not args.simular:
        print("\n✓ Listo. Antes de desconectar:  flacpipe fiio --desmontar  (o expúlsalo desde el escritorio)")
    return 0


# ─── arrancar Nicotine+ ───────────────────────────────────────────────────────

def cmd_arrancar(args):
    if _nicotine_activo():
        print("Nicotine+ ya está corriendo.")
        return 0
    ejecutable = shutil.which("nicotine-plus") or shutil.which("nicotine")
    if not ejecutable:
        print("No encuentro el ejecutable de Nicotine+.")
        return 1
    orden = [ejecutable] + (["--headless"] if args.headless else [])
    print("Arrancando: " + " ".join(orden))
    os.posix_spawn(ejecutable, orden, os.environ)
    return 0



