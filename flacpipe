#!/usr/bin/env python3
"""flacpipe — control del pipeline FLAC (Nicotine+ → ~/Música → FiiO).

PARTE 1 (automática, la ejecuta el plugin dentro de Nicotine+):
    flacpipe pedir "Radiohead - OK Computer"
    flacpipe pedir --archivo albums.txt
    flacpipe pedir --csv playlist.csv     # exportada de Spotify
    flacpipe estado

PARTE 2 (manual, la ejecutas tú cuando conectas el FiiO):
    flacpipe fiio --simular
    flacpipe fiio
    flacpipe fiio "Radiohead" "Nujabes/Modal Soul"
"""

