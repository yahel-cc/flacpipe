    if not destinos:
        linea(duda, "ninguna tarjeta montada (normal si no la tienes conectada)")
    for d in destinos:
        linea(ok, f"{d['montaje']}  ({d['tipo']}, {comun.formato_bytes(d['libre'])} libres)")
        if d["tipo"] not in ("vfat", "exfat", "msdos"):
            linea(duda, f"  el sistema de archivos es {d['tipo']}: "
                        "no puedo verificar el orden físico de las entradas")

    if args.prueba:
        _prueba_en_seco()

    print()
    if problemas:
        print(f"{mal} Faltan cosas: " + ", ".join(problemas))
        return 1
    print(f"{ok} Todo listo. La prueba de verdad es pedir un álbum:")
    print('     flacpipe pedir "Radiohead - OK Computer" && flacpipe estado')
    return 0


def albumes_incompletos(raiz=None):
    """[(Artista/Álbum, [pistas que faltan])] mirando la secuencia de cada álbum."""
    salida = []
    for item in fiio.listar_biblioteca(raiz=raiz):
        pistas, _avisos = biblioteca.analizar(item["dir"])
        faltan = sorted(n for lista in biblioteca.huecos(pistas).values() for n in lista)
        if faltan:
            salida.append((item["rel"], faltan))
    return salida


def _prueba_en_seco():
    """Genera un álbum falso, lo organiza y comprueba el resultado. No toca la red."""
    import struct
    print("\n▸ Prueba en seco del organizador (sin red)")

    carpeta = os.path.join(comun.DIR_DESCARGAS, "_prueba_en_seco")
    shutil.rmtree(carpeta, ignore_errors=True)
    os.makedirs(carpeta)

    titulos = ["Primera", "Segunda: dos puntos", "Tercera/barra", "Cuarta", "Quinta",
               "Sexta", "Séptima", "Octava", "Novena", "Décima", "Undécima", "Duodécima"]
    for i, titulo in enumerate(titulos, 1):
        si = bytearray(34)
        si[10:14] = struct.pack(">I", (96000 << 12) | (1 << 9) | ((24 - 1) << 4))
        si[14:18] = struct.pack(">I", 1000)
        campos = [f"{k}={v}".encode() for k, v in
                  {"ARTIST": "Prueba Pipeline", "ALBUMARTIST": "Prueba Pipeline",
                   "ALBUM": "Disco De Prueba", "TITLE": titulo,
                   "TRACKNUMBER": str(i)}.items()]
        vc = struct.pack("<I", 6) + b"prueba" + struct.pack("<I", len(campos))
        for c in campos:
            vc += struct.pack("<I", len(c)) + c
        with open(os.path.join(carpeta, f"pista_desordenada_{13 - i:02d}.flac"), "wb") as f:
            f.write(b"fLaC")
            f.write(bytes([0]) + len(si).to_bytes(3, "big") + bytes(si))
            f.write(bytes([0x80 | 4]) + len(vc).to_bytes(3, "big") + vc)
            f.write(os.urandom(256))

    resultado = biblioteca.organizar(carpeta)
    esperado = [f"{i:02d} {t}" for i, t in enumerate(
        ["Primera", "Segunda꞉ dos puntos", "Tercera⁄barra", "Cuarta", "Quinta", "Sexta",
         "Séptima", "Octava", "Novena", "Décima", "Undécima", "Duodécima"], 1)]
    esperado = [n + ".flac" for n in esperado]

    destino = os.path.join(comun.RAIZ_BIBLIOTECA, resultado.get("carpeta", ""))
    correcto = (resultado.get("ok") and resultado["nombres"] == esperado
                and resultado["carpeta"] == "Prueba Pipeline/Disco De Prueba"
                and resultado["calidad"] == "24-bit / 96 kHz")

    if correcto:
        print("  ✓ 12 pistas con nombres caóticos → Prueba Pipeline/Disco De Prueba/")
        print(f"       {resultado['nombres'][0]}  …  {resultado['nombres'][-1]}")
        print(f"       calidad detectada: {resultado['calidad']}")
        print("       caracteres ilegales en FAT sustituidos: ꞉ ⁄")
    else:
        print(f"  ✗ el organizador no dio el resultado esperado: {resultado}")

    shutil.rmtree(destino, ignore_errors=True)
    try:
        os.rmdir(os.path.dirname(destino))   # la carpeta de artista, si quedó vacía
    except OSError:
        pass
    shutil.rmtree(carpeta, ignore_errors=True)
    print("  (limpiado)")


# ─── interfaz ─────────────────────────────────────────────────────────────────

def cmd_tui(_args):
    """Abre la interfaz a pantalla completa. Es lo que sale al escribir `flacpipe`."""
    raiz = os.path.dirname(os.path.realpath(__file__))
    if raiz not in sys.path:
        sys.path.insert(0, raiz)
    import flacpipe_tui
    return flacpipe_tui.ejecutar()


# ─── main ─────────────────────────────────────────────────────────────────────

def main():
    p = argparse.ArgumentParser(
        prog="flacpipe", description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="orden", required=True)

    sp = sub.add_parser("tui", help="Interfaz a pantalla completa (lo mismo que "
                                    "escribir `flacpipe` a secas)")
    sp.set_defaults(func=cmd_tui)

    sp = sub.add_parser("pedir", help="Encolar álbumes o canciones para descargar")
    sp.add_argument("consulta", nargs="*", help='p. ej. "Radiohead - OK Computer"')
    sp.add_argument("--archivo", "-a", help="Archivo de texto con una consulta por línea")
    sp.add_argument("--cancion", action="store_true",
                    help="Es una canción suelta, no un álbum completo")
    sp.add_argument("--csv", metavar="RUTA",
                    help="Playlist exportada en CSV (Exportify, TuneMyMusic…): "
                         "se piden sus canciones una a una")
    sp.add_argument("--albumes", action="store_true",
                    help="Con --csv: pedir los álbumes completos en vez de las canciones")
    sp.add_argument("--repetir", action="store_true",
                    help="Con --csv: pedir también lo que ya está en la biblioteca o en la cola")
    sp.add_argument("--simular", "-n", action="store_true",
                    help="Con --csv: enseñar qué se pediría sin encolar nada")
    sp.set_defaults(func=cmd_pedir)

    sp = sub.add_parser("estado", help="Ver la cola y el progreso")
    sp.add_argument("--todo", action="store_true", help="Incluir peticiones terminadas")
    sp.add_argument("--seguir", "-f", action="store_true",
                    help="Repintar cada 5 s hasta que la cola se vacíe")
    sp.set_defaults(func=cmd_estado)

    sp = sub.add_parser("cancelar", help="Cancelar una petición activa")
    sp.add_argument("cual", help='id, parte de la consulta, o "todo"')
    sp.set_defaults(func=cmd_cancelar)

    sp = sub.add_parser("limpiar", help="Quitar de la cola lo ya terminado")
    sp.set_defaults(func=cmd_limpiar)

    sp = sub.add_parser("organizar", help="Organizar a mano lo que quedó en .descargas")
    sp.add_argument("carpeta", nargs="?", help="Carpeta concreta (por defecto, todas)")
    sp.add_argument("--simular", "-n", action="store_true", help="No mover nada")
    sp.set_defaults(func=cmd_organizar)

    sp = sub.add_parser("fiio", help="PARTE 2: copiar al FiiO en orden estricto")
    sp.add_argument("filtro", nargs="*", help='"Artista" o "Artista/Álbum"')
    sp.add_argument("--destino", "-d", help="Punto de montaje de la tarjeta")
    sp.add_argument("--raiz", help="Biblioteca de origen (por defecto ~/Música; "
                                   "usa ~/Música/Artistas para la biblioteca heredada)")
    sp.add_argument("--subcarpeta", default=fiio.DESTINO_REL_POR_DEFECTO,
                    help=f"Subcarpeta dentro de la tarjeta (por defecto {fiio.DESTINO_REL_POR_DEFECTO})")
    sp.add_argument("--simular", "-n", action="store_true", help="Mostrar el plan sin copiar")
    sp.add_argument("--rehacer", action="store_true",
                    help="Borrar y reescribir los álbumes que ya estén, para forzar el orden")
    sp.add_argument("--si", "-y", action="store_true", help="No preguntar")
    sp.add_argument("--desmontar", action="store_true", help="sync y desmontar al terminar")
    sp.set_defaults(func=cmd_fiio)

    sp = sub.add_parser("revisar", help="Diagnóstico: ¿está todo bien conectado?")
    sp.add_argument("--prueba", action="store_true",
                    help="Además, organizar un álbum falso para probar la parte 1 sin red")
    sp.set_defaults(func=cmd_revisar)

    sp = sub.add_parser("arrancar", help="Abrir Nicotine+ si no está corriendo")
    sp.add_argument("--headless", action="store_true", help="Sin ventana")
    sp.set_defaults(func=cmd_arrancar)

    # Sin argumentos se abre la interfaz: antes esto sólo daba un error de uso.
    if len(sys.argv) == 1:
        comun.asegurar_dirs()
        return cmd_tui(None)

    args = p.parse_args()
    comun.asegurar_dirs()
    return args.func(args) or 0


if __name__ == "__main__":
    sys.exit(main())
