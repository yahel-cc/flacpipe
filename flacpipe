              "flacpipe organizar")

    print("\n▸ Álbumes incompletos en la biblioteca")
    incompletos = albumes_incompletos()
    if not incompletos:
        linea(ok, "ningún álbum tiene huecos en la numeración")
    for rel, faltan in incompletos:
