# Viven en fh_comun porque la vista de salud de la interfaz usa lo mismo.
DIR_SNAP = comun.DIR_SNAP
ENLACE_PLUGIN = comun.ENLACE_PLUGIN
CONFIG_NICOTINE = comun.CONFIG_NICOTINE
_ultimo_arranque_plugin = comun.ultimo_arranque_plugin
_snap_lee_plugin = comun.snap_lee_plugin


def cmd_revisar(args):
    ok = "✓"
    mal = "✗"
    duda = "! "
    problemas = []

    def linea(estado, texto, detalle=""):
        print(f"  {estado} {texto}" + (f"\n       {detalle}" if detalle else ""))

    print("\n▸ Instalación")

    destino = os.path.realpath(ENLACE_PLUGIN) if os.path.exists(ENLACE_PLUGIN) else None
    if destino and os.path.isfile(os.path.join(destino, "__init__.py")):
        linea(ok, "el plugin está enlazado en el snap", destino)
    else:
        linea(mal, "el plugin NO está instalado", "ejecuta: bash instalar.sh")
