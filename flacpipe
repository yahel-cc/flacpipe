    try:
        texto = open(CONFIG_NICOTINE, encoding="utf-8").read()
        habilitado = "'flac_hunter'" in texto
        descargas_ok = "downloaddir = /home/yahel/Música/.descargas" in texto
    except OSError:
        habilitado = descargas_ok = False
    linea(ok if habilitado else mal,
          "está habilitado en la config de Nicotine+" if habilitado
